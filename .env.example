# Môi trường ứng dụng và Cổng dịch vụ
NODE_ENV=production
PORT=3000

# Cơ sở dữ liệu PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=hrm_user
DB_PASSWORD=hrm_password123
DB_NAME=hrm_db

# Chuỗi bí mật JWT Token (dùng mã hóa phiên đăng nhập)
JWT_SECRET=hrm_secure_jwt_secret_devops_2026

# Quản trị pgAdmin 4
PGADMIN_DEFAULT_EMAIL=admin@hrm.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Bảng điều khiển Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
