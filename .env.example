# Cấu hình Cổng và Môi trường
NODE_ENV=production
PORT=3000

# Cấu hình Cơ sở dữ liệu PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=hrm_user
DB_PASSWORD=hrm_password123
DB_NAME=hrm_db

# Cấu hình pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@hrm.com
PGADMIN_DEFAULT_PASSWORD=admin123

# Cấu hình Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
