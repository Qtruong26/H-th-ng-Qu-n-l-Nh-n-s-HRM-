      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(hrm_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "P95 Latency (s)",
          "refId": "A"
        }
      ]
